# CareerLens AI — copy to .env in this folder or into backend/.env
# Never commit real secrets.

# Backend
CAREERLENS_ENV=development
CAREERLENS_HOST=0.0.0.0
CAREERLENS_PORT=8000
CAREERLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# PostgreSQL (required only if you want to save analysis history)
# Analysis itself works without a database.
DATABASE_URL=postgresql+psycopg://careerlens:careerlens_dev@localhost:5432/careerlens
DATABASE_ENABLED=true

# Upload limits
MAX_UPLOAD_MB=5

# Frontend (used by Vite at build/dev time)
# Leave empty in local dev so Vite can proxy /api to the backend.
VITE_API_URL=
